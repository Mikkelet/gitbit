<%- include('header') %>
<div class="container">
  <h1><a href="/<%= repo %>"><%= repo %></a> &mdash; Commits</h1>

  <div class="commit-list">
    <% for (const c of commits) { %>
      <div class="commit-entry">
        <a href="/<%= repo %>/commit/<%= c.hash %>" class="commit-hash"><%= c.shortHash %></a>
        <span class="commit-msg"><%= c.message %></span>
        <span class="commit-meta"><%= c.author %> &middot; <%= c.date %></span>
      </div>
    <% } %>
  </div>

  <div class="pagination">
    <% if (page > 0) { %>
      <a href="/<%= repo %>/commits/<%= branch %>?page=<%= page - 1 %>">&larr; Newer</a>
    <% } %>
    <% if (commits.length === 30) { %>
      <a href="/<%= repo %>/commits/<%= branch %>?page=<%= page + 1 %>">Older &rarr;</a>
    <% } %>
  </div>
</div>
<%- include('footer') %>
